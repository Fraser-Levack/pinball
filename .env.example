# Copy to .env.local and fill in from Supabase: Project Settings -> API.
# The service role key bypasses row level security. Keep it server-side only.
SUPABASE_URL=https://wsqmmdvuabcrhmvadfpl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=sb_publishable_ppbyYFbeR_0oDlmgFoJlDw_aQtct3wZ

# Builds. Locally the game runs Claude Code on this computer. When hosted (on Vercel, detected
# automatically) players paste their own Anthropic API key instead, and finished apps are saved to
# Supabase. Force either mode with PINBALL_BUILD_MODE=cloud or PINBALL_BUILD_MODE=local.
# PINBALL_BUILD_MODE=cloud
# Cloud builds are signed so only real ones can be saved. The signing key defaults to the service
# role key; set this to use a separate secret (any long random string):
# BUILD_SIGNING_SECRET=
